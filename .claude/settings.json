{
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "permissions": {
    "allow": [
      "Bash(bash -n .claude/scripts/task.sh)",
      "Bash(.claude/scripts/task.sh -h)",
      "Bash(.claude/scripts/task.sh slash *)",
      "Bash(.claude/scripts/task.sh list)",
      "Bash(.claude/scripts/task.sh list *)",
      "Bash(.claude/scripts/task.sh where *)",
      "Bash(.claude/scripts/task.sh root)",
      "Bash(.claude/scripts/task.sh report *)",
      "Bash(.claude/scripts/task.sh start *)",
      "Bash(bash -n .claude/scripts/tasklib.sh)",
      "Bash(.claude/scripts/ccs.sh:*)",
      "Bash(bash -n .claude/scripts/ccs.sh)",
      "Bash(.claude/scripts/learn.sh:*)",
      "Bash(bash -n .claude/scripts/learn.sh)",
      "Bash(.claude/scripts/release-notes.sh:*)",
      "Bash(bash -n .claude/scripts/release-notes.sh)",
      "Bash(.claude/scripts/graph.sh:*)",
      "Bash(bash -n .claude/scripts/graph.sh)",
      "Bash(.claude/scripts/guard-test.sh)",
      "Bash(.claude/scripts/guard-test.sh -q)",
      "Bash(bash -n .claude/scripts/guard-test.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh auth status)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/scripts/guard.sh\""
          }
        ]
      }
    ]
  }
}
