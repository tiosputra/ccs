# Per-machine workspace settings. Copy to `.env` and edit; `.env` is
# gitignored, so everyone can differ without touching a tracked file.
#
#   cp .env.example .env
#
# The environment still wins over this file, so a one-off override works:
#
#   TASK_BRANCH_PREFIX=spike .claude/scripts/task.sh start try-it <repo>
#
# `/task config` prints what each setting resolved to and where it came from.
# The TASK_* settings were SPACE_* before; the old names are still read.

# Prefix for the branch a task creates: <prefix>/<task>.
# Usually your own handle, so your branches are recognisable on the remote.
TASK_BRANCH_PREFIX=ccs

# Base ref new branches start from when `--from` is not given.
# `/plan-prd` still asks rather than letting this decide silently.
TASK_DEFAULT_BASE=origin/main

# Where a new task works unless it is started with --space or --inplace:
#   inplace  each repo's own checkout, repos/<repo>, switched to the task branch
#   space    a git worktree per repo under spaces/<task>/
TASK_DEFAULT_ISOLATION=inplace

# Repos that exist for reference only: read them, search them, ask questions
# about them - never edit, commit, or generate into them. Comma list of the
# directory names under repos/. A reference repo never joins a task, and the
# guard hook refuses writes to it everywhere, in repos/ and in any space.
# Empty (the default) means every checkout is workable. For example:
#
#   REFERENCE_REPOS=mobile,partner
REFERENCE_REPOS=
