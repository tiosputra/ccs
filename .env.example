# Per-machine workspace settings. Copy to `.env` and edit; `.env` is
# gitignored, so everyone can differ without touching a tracked file.
#
#   cp .env.example .env
#
# The environment still wins over this file, so a one-off override works:
#
#   SPACE_BRANCH_PREFIX=spike .claude/scripts/space.sh add try-it backend
#
# `/space config` prints what each setting resolved to and where it came from.

# Prefix for the branch a space creates: <prefix>/<task>.
# Usually your own handle, so your branches are recognisable on the remote.
SPACE_BRANCH_PREFIX=ccs

# Base ref new branches start from when `--from` is not given.
# `/space add` still asks rather than letting this decide silently.
SPACE_DEFAULT_BASE=origin/main

# Repos that exist for reference only: read them, search them, ask questions
# about them - never edit, commit, or generate into them. Comma list of the
# directory names under repos/. A reference repo gets no worktree in a space,
# and the guard hook refuses writes to repos/<repo> and spaces/<task>/<repo>.
# Empty (the default) means every checkout is workable.
REFERENCE_REPOS=mobile,partner
